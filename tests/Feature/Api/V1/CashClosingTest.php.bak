<?php

declare(strict_types=1);

use App\Models\CashClosing;
use App\Models\CashClosingLine;
use App\Models\CashShift;
use App\Models\Store;
use App\Models\StoreUser;
use App\Models\User;

use function Pest\Laravel\actingAs;

beforeEach(function () {
    $this->store = Store::create([
        'name' => 'Test Store',
        'city' => 'Test City',
        'active' => true,
    ]);

    $this->vendedor = User::create([
        'name' => 'Vendedor Test',
        'email' => 'vendedor@example.com',
        'password' => bcrypt('password'),
        'active' => true,
    ]);

    $this->conferente = User::create([
        'name' => 'Conferente Test',
        'email' => 'conferente@example.com',
        'password' => bcrypt('password'),
        'active' => true,
    ]);

    StoreUser::create([
        'store_id' => $this->store->id,
        'user_id' => $this->vendedor->id,
        'role' => 'vendedor',
    ]);

    StoreUser::create([
        'store_id' => $this->store->id,
        'user_id' => $this->conferente->id,
        'role' => 'conferente',
    ]);

    // Create shift with closing
    $this->shift = CashShift::create([
        'store_id' => $this->store->id,
        'date' => now()->format('Y-m-d'),
        'shift_code' => 'M',
        'seller_id' => $this->vendedor->id,
        'status' => 'open',
    ]);

    $this->closing = CashClosing::create([
        'cash_shift_id' => $this->shift->id,
        'status' => 'draft',
        'version' => 1,
    ]);
});

// ================================================
// Submit Tests
// ================================================

test('submit closing succeeds even with divergence (justification now optional)', function () {
    // Create line with divergence but no justification - this should now be allowed
    CashClosingLine::create([
        'cash_closing_id' => $this->closing->id,
        'label' => 'Dinheiro',
        'system_value' => 1000.00,
        'real_value' => 950.00,
        'diff_value' => -50.00,
    ]);

    $response = actingAs($this->vendedor)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}/submit");

    // Now succeeds because justification is optional at shift level
    $response->assertStatus(200)
        ->assertJsonPath('data.status', 'submitted');

    expect($this->closing->fresh()->status)->toBe('submitted');
    expect($this->shift->fresh()->status)->toBe('pending');
});

test('submit closing succeeds with no divergences', function () {
    // Create line with NO divergence
    CashClosingLine::create([
        'cash_closing_id' => $this->closing->id,
        'label' => 'Dinheiro',
        'system_value' => 1000.00,
        'real_value' => 1000.00,
        'diff_value' => 0,
    ]);

    $response = actingAs($this->vendedor)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}/submit");

    $response->assertStatus(200)
        ->assertJsonPath('data.status', 'submitted');
});

// ================================================
// Approve Tests
// ================================================

test('approve closing requires conferente or higher role', function () {
    $this->closing->update(['status' => 'submitted']);

    $response = actingAs($this->vendedor)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}/approve");

    $response->assertStatus(403);
});

test('conferente can approve submitted closing', function () {
    $this->closing->update(['status' => 'submitted']);

    $response = actingAs($this->conferente)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}/approve");

    $response->assertStatus(200)
        ->assertJsonPath('data.status', 'approved');

    expect($this->closing->fresh()->status)->toBe('approved');
    expect($this->shift->fresh()->status)->toBe('closed');
});

// ================================================
// Reject Tests
// ================================================

test('reject closing requires reason', function () {
    $this->closing->update(['status' => 'submitted']);

    $response = actingAs($this->conferente)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}/reject");

    $response->assertStatus(422)
        ->assertJsonValidationErrors(['reason']);
});

test('conferente can reject submitted closing with reason', function () {
    $this->closing->update(['status' => 'submitted']);

    $response = actingAs($this->conferente)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}/reject", [
            'reason' => 'Valores não conferem com o relatório do PDV',
        ]);

    $response->assertStatus(200)
        ->assertJsonPath('data.status', 'rejected');

    expect($this->closing->fresh()->status)->toBe('rejected');
    expect($this->shift->fresh()->status)->toBe('open');
});

// ================================================
// Status Constraint Tests
// ================================================

test('cannot approve already approved closing', function () {
    $this->closing->update(['status' => 'approved']);

    $response = actingAs($this->conferente)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}/approve");

    $response->assertStatus(409);
});

test('cannot submit already submitted closing', function () {
    $this->closing->update(['status' => 'submitted']);

    $response = actingAs($this->vendedor)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}/submit");

    $response->assertStatus(409);
});

// ================================================
// Create/Update Closing Tests (NEW)
// ================================================

test('can create closing with POST', function () {
    // Create a new shift without closing
    $newShift = CashShift::create([
        'store_id' => $this->store->id,
        'date' => now()->format('Y-m-d'),
        'shift_code' => 'T',
        'seller_id' => $this->vendedor->id,
        'status' => 'open',
    ]);

    $response = actingAs($this->vendedor)
        ->postJson("/api/v1/cash/closings/{$newShift->id}", [
            'lines' => [
                ['label' => 'Dinheiro', 'system_value' => 1000, 'real_value' => 950],
                ['label' => 'PIX', 'system_value' => 500, 'real_value' => 500],
            ],
            'justification_text' => 'Troco incorreto',
            'justified' => true,
        ]);

    $response->assertStatus(201)
        ->assertJsonPath('data.status', 'draft')
        ->assertJsonPath('data.justification_text', 'Troco incorreto')
        ->assertJsonPath('data.justified', true);

    expect($newShift->fresh()->cashClosing)->not->toBeNull();
    expect($newShift->fresh()->cashClosing->lines)->toHaveCount(2);
});

test('cannot create closing if one already exists', function () {
    $response = actingAs($this->vendedor)
        ->postJson("/api/v1/cash/closings/{$this->shift->id}", [
            'lines' => [
                ['label' => 'Dinheiro', 'system_value' => 100, 'real_value' => 100],
            ],
        ]);

    $response->assertStatus(409);
});

test('can update closing with PUT', function () {
    CashClosingLine::create([
        'cash_closing_id' => $this->closing->id,
        'label' => 'Dinheiro',
        'system_value' => 1000.00,
        'real_value' => 1000.00,
        'diff_value' => 0,
    ]);

    $response = actingAs($this->vendedor)
        ->putJson("/api/v1/cash/closings/{$this->shift->id}", [
            'lines' => [
                ['label' => 'Dinheiro', 'system_value' => 1000, 'real_value' => 900],
                ['label' => 'PIX', 'system_value' => 200, 'real_value' => 200],
            ],
            'justification_text' => 'Faltou troco',
            'justified' => true,
        ]);

    $response->assertStatus(200)
        ->assertJsonPath('data.justification_text', 'Faltou troco')
        ->assertJsonPath('data.justified', true);

    $closing = $this->closing->fresh();
    expect($closing->lines)->toHaveCount(2);
    expect($closing->version)->toBe(2);
});

test('cannot update approved closing', function () {
    $this->closing->update(['status' => 'approved']);

    $response = actingAs($this->vendedor)
        ->putJson("/api/v1/cash/closings/{$this->shift->id}", [
            'lines' => [
                ['label' => 'Dinheiro', 'system_value' => 100, 'real_value' => 100],
            ],
        ]);

    $response->assertStatus(409);
});

// ================================================
// Shift-Level Justification Tests (NEW)
// ================================================

test('justified flag affects bonus calculation logic', function () {
    CashClosingLine::create([
        'cash_closing_id' => $this->closing->id,
        'label' => 'Dinheiro',
        'system_value' => 1000.00,
        'real_value' => 950.00,
        'diff_value' => -50.00,
    ]);

    // Not justified - should affect bonus
    $this->closing->update(['justified' => false]);
    expect($this->closing->fresh()->hasDivergence())->toBeTrue();
    expect($this->closing->fresh()->hasUnjustifiedDivergence())->toBeTrue();

    // Justified - should not affect bonus
    $this->closing->update(['justified' => true]);
    expect($this->closing->fresh()->hasDivergence())->toBeTrue();
    expect($this->closing->fresh()->hasUnjustifiedDivergence())->toBeFalse();
});
