# MaisCapinhas ERP API - HTTP Requests
# Use com a extensão REST Client do VS Code

@baseUrl = http://localhost:8000/api/v1
@token = {{login.response.body.data.token}}

### ==============================================
### HEALTH & VERSION (Public)
### ==============================================

### Health Check
GET {{baseUrl}}/health

### Version Info
GET {{baseUrl}}/version

### ==============================================
### AUTHENTICATION
### ==============================================

### Login (Admin)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@maiscapinhas.com.br",
    "password": "password"
}

### Login (Gerente)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "carlos.gerente@maiscapinhas.com.br",
    "password": "password"
}

### Login (Vendedor)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "joao.vendedor@maiscapinhas.com.br",
    "password": "password"
}

### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

### ==============================================
### ME
### ==============================================

### Get Current User
GET {{baseUrl}}/me
Authorization: Bearer {{token}}

### ==============================================
### STORES
### ==============================================

### List My Stores
GET {{baseUrl}}/stores
Authorization: Bearer {{token}}

### Get Store Details
GET {{baseUrl}}/stores/1
Authorization: Bearer {{token}}

### ==============================================
### BONUS RULES (admin/gerente)
### ==============================================

### List Bonus Rules
GET {{baseUrl}}/rules/bonus
Authorization: Bearer {{token}}

### Create Global Bonus Rule
POST {{baseUrl}}/rules/bonus
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "store_id": null,
    "effective_from": "2026-01-01",
    "config_json": [
        {"min_sales": 500, "bonus": 10},
        {"min_sales": 800, "bonus": 20},
        {"min_sales": 1200, "bonus": 35}
    ]
}

### Create Store-Specific Bonus Rule
POST {{baseUrl}}/rules/bonus
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "store_id": 1,
    "effective_from": "2026-01-01",
    "config_json": [
        {"min_sales": 400, "bonus": 15},
        {"min_sales": 700, "bonus": 25}
    ]
}

### Get Bonus Rule
GET {{baseUrl}}/rules/bonus/1
Authorization: Bearer {{token}}

### Update Bonus Rule
PUT {{baseUrl}}/rules/bonus/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "effective_from": "2026-02-01",
    "config_json": [
        {"min_sales": 600, "bonus": 12},
        {"min_sales": 1000, "bonus": 25}
    ]
}

### Delete Bonus Rule
DELETE {{baseUrl}}/rules/bonus/1
Authorization: Bearer {{token}}

### ==============================================
### COMMISSION RULES (admin/gerente)
### ==============================================

### List Commission Rules
GET {{baseUrl}}/rules/commission
Authorization: Bearer {{token}}

### Create Global Commission Rule
POST {{baseUrl}}/rules/commission
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "store_id": null,
    "effective_from": "2026-01-01",
    "config_json": [
        {"min_attainment": 0, "rate": 2},
        {"min_attainment": 80, "rate": 2.5},
        {"min_attainment": 100, "rate": 3},
        {"min_attainment": 120, "rate": 4}
    ]
}

### Get Commission Rule
GET {{baseUrl}}/rules/commission/1
Authorization: Bearer {{token}}

### ==============================================
### MONTHLY GOALS (admin/gerente)
### ==============================================

### List Goals
GET {{baseUrl}}/goals/monthly
Authorization: Bearer {{token}}

### List Goals for Store
GET {{baseUrl}}/goals/monthly?store_id=1
Authorization: Bearer {{token}}

### Create Monthly Goal
POST {{baseUrl}}/goals/monthly
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "store_id": 1,
    "month": "2026-02",
    "goal_amount": 75000.00,
    "active": true
}

### Get Goal Details
GET {{baseUrl}}/goals/monthly/1
Authorization: Bearer {{token}}

### Update Goal Amount
PUT {{baseUrl}}/goals/monthly/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "goal_amount": 80000.00
}

### Set Goal Splits (must sum to 100%)
PUT {{baseUrl}}/goals/monthly/1/splits
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "splits": [
        {"user_id": 6, "percent": 50.00},
        {"user_id": 7, "percent": 50.00}
    ]
}

### Set Unequal Splits
PUT {{baseUrl}}/goals/monthly/2/splits
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "splits": [
        {"user_id": 8, "percent": 45.00},
        {"user_id": 9, "percent": 55.00}
    ]
}

### ==============================================
### FINANCE LEDGER
### ==============================================

### Get Bonus Ledger
GET {{baseUrl}}/finance/bonus?store_id=1&from=2026-01-01&to=2026-01-31
Authorization: Bearer {{token}}

### Get Bonus (vendedor sees own only)
GET {{baseUrl}}/finance/bonus
Authorization: Bearer {{token}}

### Get Commission Ledger
GET {{baseUrl}}/finance/commission?store_id=1&month=2026-01
Authorization: Bearer {{token}}

### Get Commission (vendedor sees own only)
GET {{baseUrl}}/finance/commission
Authorization: Bearer {{token}}

### ==============================================
### PEOPLE ANALYTICS
### ==============================================

### Get People KPIs for Store/Date
GET {{baseUrl}}/analytics/people/shift?store_id=1&date=2026-01-07
Authorization: Bearer {{token}}

### Insert Manual KPI
POST {{baseUrl}}/analytics/people/shift
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "store_id": 1,
    "date": "2026-01-07",
    "shift_code": "N",
    "in_count": 45,
    "out_count": 12,
    "staff_in": 2,
    "staff_out": 2
}

### ==============================================
### SALES
### ==============================================

### List Sales
GET {{baseUrl}}/sales?store_id=1&from=2026-01-01&to=2026-01-31
Authorization: Bearer {{token}}

### ==============================================
### CASH SHIFTS & CLOSINGS
### ==============================================

### List Shifts
GET {{baseUrl}}/cash/shifts?store_id=1
Authorization: Bearer {{token}}

### Get Closing Details
GET {{baseUrl}}/cash/closings/1
Authorization: Bearer {{token}}

### Submit Closing
POST {{baseUrl}}/cash/closings/1/submit
Authorization: Bearer {{token}}

### Approve Closing (conferente/gerente/admin)
POST {{baseUrl}}/cash/closings/1/approve
Authorization: Bearer {{token}}

### Reject Closing
POST {{baseUrl}}/cash/closings/1/reject
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "reason": "Valores não conferem com relatório do PDV"
}

### ==============================================
### DASHBOARDS
### ==============================================

### Dashboard Vendedor
GET {{baseUrl}}/dashboard/vendedor?store_id=1
Authorization: Bearer {{token}}

### Dashboard Conferente
GET {{baseUrl}}/dashboard/conferente?store_id=1
Authorization: Bearer {{token}}

### Dashboard Admin
GET {{baseUrl}}/dashboard/admin?month=2026-01
Authorization: Bearer {{token}}

### ==============================================
### ADMIN - USERS (admin only)
### ==============================================

### List All Users
GET {{baseUrl}}/admin/users
Authorization: Bearer {{token}}

### Search Users
GET {{baseUrl}}/admin/users?search=joao&active=true
Authorization: Bearer {{token}}

### Create User
POST {{baseUrl}}/admin/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Novo Vendedor",
    "email": "novo.vendedor@maiscapinhas.com.br",
    "password": "senha123456",
    "active": true,
    "stores": [
        {"store_id": 1, "role": "vendedor"}
    ]
}

### Get User Details
GET {{baseUrl}}/admin/users/6
Authorization: Bearer {{token}}

### Update User
PUT {{baseUrl}}/admin/users/6
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "João da Silva Atualizado"
}

### Deactivate User
DELETE {{baseUrl}}/admin/users/6
Authorization: Bearer {{token}}

### ==============================================
### ADMIN - STORES (admin only)
### ==============================================

### List All Stores
GET {{baseUrl}}/admin/stores
Authorization: Bearer {{token}}

### Create Store
POST {{baseUrl}}/admin/stores
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Mais Capinhas Centro",
    "city": "Florianópolis",
    "active": true
}

### Get Store Details
GET {{baseUrl}}/admin/stores/1
Authorization: Bearer {{token}}

### Update Store
PUT {{baseUrl}}/admin/stores/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Mais Capinhas Tijucas - Centro"
}

### Deactivate Store
DELETE {{baseUrl}}/admin/stores/4
Authorization: Bearer {{token}}

### ==============================================
### ADMIN - STORE-USER BINDINGS (admin only)
### ==============================================

### List Users in Store
GET {{baseUrl}}/admin/stores/1/users
Authorization: Bearer {{token}}

### Add User to Store
POST {{baseUrl}}/admin/stores/1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "user_id": 8,
    "role": "vendedor"
}

### Update User Role in Store
PUT {{baseUrl}}/admin/stores/1/users/6
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "role": "gerente"
}

### Remove User from Store
DELETE {{baseUrl}}/admin/stores/1/users/8
Authorization: Bearer {{token}}

### ==============================================
### SALES CRUD
### ==============================================

### List Sales
GET {{baseUrl}}/sales?store_id=1&from=2026-01-01&to=2026-01-31
Authorization: Bearer {{token}}

### Create Sale (manual)
POST {{baseUrl}}/sales
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "store_id": 1,
    "seller_id": 6,
    "sold_at": "2026-01-07T15:30:00",
    "amount": 175.50,
    "source": "manual"
}

### Get Sale Details
GET {{baseUrl}}/sales/1
Authorization: Bearer {{token}}

### Update Sale
PUT {{baseUrl}}/sales/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "amount": 180.00
}

### Delete Sale (admin only)
DELETE {{baseUrl}}/sales/1
Authorization: Bearer {{token}}

### ==============================================
### ARTISAN COMMANDS (run in terminal)
### ==============================================

# Sync People Analytics from FastAPI
# php artisan people:sync-kpis --store=1 --date=2026-01-07

# Sync all stores
# php artisan people:sync-kpis --all-stores --date=2026-01-07

# Run queue worker for bonus/commission recalculation
# php artisan queue:work --queue=finance

# Generate Scribe documentation
# php artisan scribe:generate

