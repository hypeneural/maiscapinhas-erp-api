# ==============================================================================
# MaisCapinhas ERP API - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# For Laragon Windows setup, most defaults should work out of the box.
# ==============================================================================

APP_NAME="MaisCapinhas ERP API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Use one of these options:
# Option A: artisan serve
APP_URL=http://localhost:8000
# Option B: Laragon virtual host
# APP_URL=http://maiscapinhas-erp-api.test

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# ==============================================================================
# LOGGING - JSON format for production, stack for local
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# DATABASE - MySQL (Laragon)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maiscapinhas_erp
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+00:00
DB_CHARSET=utf8mb4
# DB_COLLATION - omit to use MySQL 8 default (utf8mb4_0900_ai_ci)

# ==============================================================================
# CACHE & SESSIONS - File (default) or Redis (if installed)
# ==============================================================================
# Default (works without Redis)
CACHE_STORE=file
SESSION_DRIVER=file

# Production API (recommended with Redis local-only):
# CACHE_STORE=redis
# SESSION_DRIVER=file
# CACHE_PREFIX=mc_api_cache_

# ==============================================================================
# QUEUE - Sync (default) or Redis (if installed)
# ==============================================================================
# Default (runs jobs immediately - works without Redis)
QUEUE_CONNECTION=sync

# Production webhook ingestion (recommended):
# QUEUE_CONNECTION=redis
# QUEUE_FAILED_DRIVER=database-uuids

# ==============================================================================
# PDV WEBHOOK
# ==============================================================================
# Auth mode: hmac | bearer | auto
PDV_AUTH_MODE=auto
# Shared HMAC secret for /api/v1/pdv/sync
PDV_HMAC_SECRET=
# Transitional fallback for legacy agent auth (Bearer token)
PDV_ALLOW_BEARER_FALLBACK=false
PDV_BEARER_TOKEN=
# Timestamp mode: strict | tolerant
PDV_TIMESTAMP_MODE=tolerant
# Supported schema versions (comma separated)
PDV_SUPPORTED_SCHEMA_VERSIONS=2.0
# Optional JSON Schema validation at ingress
PDV_JSON_SCHEMA_VALIDATION_ENABLED=false
PDV_JSON_SCHEMA_FILE_2_0=docs/schema_v2.0.json
# 10 minutes
PDV_TIMESTAMP_TOLERANCE_SECONDS=600
# Timezone used when payload datetime has no offset
PDV_NAIVE_DATETIME_TIMEZONE=America/Sao_Paulo
# Webhook rate limit per minute
PDV_RATE_LIMIT_PER_MINUTE=180
# Queue used by PDV processing jobs
PDV_QUEUE_NAME=pdv
# Lock duration per store while processing jobs
PDV_STORE_LOCK_SECONDS=30
# RAW payload retention (days)
PDV_RAW_RETENTION_DAYS=30
# Auto-retry failed syncs via scheduler
PDV_RETRY_FAILED_ENABLED=false
PDV_RETRY_FAILED_LIMIT=200
PDV_RETRY_FAILED_MAX_ATTEMPTS=8
PDV_RETRY_FAILED_OLDER_THAN_MINUTES=15

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=mc:api:
# Queue tuning (retry_after must be > worker timeout)
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
REDIS_QUEUE_BLOCK_FOR=5
# Cache store tuning
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# ==============================================================================
# SESSION CONFIGURATION
# ==============================================================================
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# ==============================================================================
# SANCTUM - SPA Authentication
# ==============================================================================
# Stateful domains for cookie-based SPA auth (React frontend)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000,maiscapinhas-erp-api.test

# ==============================================================================
# CORS - Frontend URL
# ==============================================================================
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# MAIL (configure when needed)
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# AWS (configure when deploying)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# VITE (for asset compilation if needed)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
