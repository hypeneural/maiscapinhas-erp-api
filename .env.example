# ==============================================================================
# MaisCapinhas ERP API - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# For Laragon Windows setup, most defaults should work out of the box.
# ==============================================================================

APP_NAME="MaisCapinhas ERP API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Use one of these options:
# Option A: artisan serve
APP_URL=http://localhost:8000
# Option B: Laragon virtual host
# APP_URL=http://maiscapinhas-erp-api.test

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# ==============================================================================
# LOGGING - JSON format for production, stack for local
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# DATABASE - MySQL (Laragon)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maiscapinhas_erp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# DB_COLLATION - omit to use MySQL 8 default (utf8mb4_0900_ai_ci)

# ==============================================================================
# CACHE & SESSIONS - File (default) or Redis (if installed)
# ==============================================================================
# Default (works without Redis)
CACHE_STORE=file
SESSION_DRIVER=file

# If Redis is installed, uncomment these:
# CACHE_STORE=redis
# SESSION_DRIVER=redis

# ==============================================================================
# QUEUE - Sync (default) or Redis (if installed)
# ==============================================================================
# Default (runs jobs immediately - works without Redis)
QUEUE_CONNECTION=sync

# If Redis is installed, uncomment:
# QUEUE_CONNECTION=redis

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# SESSION CONFIGURATION
# ==============================================================================
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# ==============================================================================
# SANCTUM - SPA Authentication
# ==============================================================================
# Stateful domains for cookie-based SPA auth (React frontend)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000,maiscapinhas-erp-api.test

# ==============================================================================
# CORS - Frontend URL
# ==============================================================================
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# MAIL (configure when needed)
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# AWS (configure when deploying)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==============================================================================
# VITE (for asset compilation if needed)
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
